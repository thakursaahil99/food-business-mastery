# Public URL of this site (used for metadata / OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API base, e.g. http://localhost:8000/api/v1
# Leave EMPTY to run the portal on mock data (dev OTP: 123456).
API_URL=

# Signs the mock session cookie (16+ chars; required in production)
SESSION_SECRET=

# Main (super) admin for the admin console (mock mode). Keep real values in .env.local only.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=

# Temporary OTP bypass for listed numbers (comma-separated). Never enable in production.
ENABLE_DEV_LOGIN=false
DEV_DIRECT_LOGIN=
